# Copie ce fichier en "secrets.toml" (dans ce même dossier .streamlit/) et
# renseigne ta propre clé. Ce fichier .example est le seul versionné dans
# git — secrets.toml lui-même est ignoré (voir .gitignore) et reste
# uniquement sur ta machine.

# Clé API OpenRouteService (https://openrouteservice.org/dev/#/signup),
# gratuite (inscription par email, sans carte bancaire). Utilisée pour le
# calcul des temps de trajet réels. Si absente, l'app retombe
# automatiquement sur le service public OSRM (gratuit mais moins fiable).
ORS_API_KEY = "colle-ta-cle-ici"
