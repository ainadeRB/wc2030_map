# Fichiers présents dans le dépôt mais exclus du ZIP téléchargeable
# ("Code" -> "Download ZIP" sur GitHub) : utiles pour développer ici,
# sans intérêt pour quelqu'un qui télécharge juste l'app pour la lancer
# en local (voir Lancer_l_app.bat).
.devcontainer export-ignore
.gitattributes export-ignore
.gitignore export-ignore

# Contient des URLs vers de vraies photos d'hôtels (utile UNIQUEMENT pour la
# version hébergée en ligne, qui n'a pas de disque local persistant — voir
# src/photos.py). Exclu du ZIP téléchargeable pour que la version offline
# n'aille jamais chercher de photos sur internet : seul data/photos/ (local,
# jamais versionné) doit fournir des photos dans cette version.
data/photos_manifest.json export-ignore
